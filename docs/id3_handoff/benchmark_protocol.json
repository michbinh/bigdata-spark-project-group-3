        "formats": [
            "csv",
            "json",
            "parquet",
            "orc"
        ],
        "format_order": [
            "csv",
            "json",
            "parquet",
            "orc"
        ],
        "warmup_runs": 1,
        "official_runs": 3,
        "summary_statistic": "median",
        "input_partitions": 16,
        "persistence": "DISK_ONLY",
        "compression_policy": {
            "csv": "default / no explicit compression option",
            "json": "default / no explicit compression option",
            "parquet": "snappy",
